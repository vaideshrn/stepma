
#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>

// ---------------- PIN CONFIGURATION ----------------

#define PIEZO_PIN   4
#define FSR_PIN     5
#define BATTERY_PIN 6

#define SDA_PIN     8
#define SCL_PIN     9

// ---------------- MPU6050 ----------------

Adafruit_MPU6050 mpu;

// ---------------- BATTERY ----------------

const float R1 = 10000.0;
const float R2 = 1000.0;

const float BATTERY_EMPTY = 3.30;
const float BATTERY_FULL = 4.20;

// ---------------- STEP DETECTION ----------------

int stepCount = 0;

float previousMagnitude = 0;

unsigned long lastStepTime = 0;

#define STEP_THRESHOLD 1.25
#define STEP_INTERVAL 300

// ---------------- PIEZO ----------------

int piezoBaseline = 0;

void setup() {

  Serial0.begin(115200);

  analogReadResolution(12);

  analogSetPinAttenuation(PIEZO_PIN, ADC_11db);
  analogSetPinAttenuation(FSR_PIN, ADC_11db);
  analogSetPinAttenuation(BATTERY_PIN, ADC_11db);

  // Initialize I2C
  Wire.begin(SDA_PIN, SCL_PIN);

  delay(1000);

  Serial0.println("SHOE SENSOR SYSTEM STARTING");

  // Initialize MPU6050
  if (!mpu.begin(0x68, &Wire)) {

    Serial0.println("MPU6050 NOT FOUND!");

    while (1) {
      delay(1000);
    }
  }

  mpu.setAccelerometerRange(
    MPU6050_RANGE_8_G
  );

  mpu.setGyroRange(
    MPU6050_RANGE_500_DEG
  );

  mpu.setFilterBandwidth(
    MPU6050_BAND_21_HZ
  );

  Serial0.println("MPU6050 CONNECTED");

  // Calibrate piezo baseline
  long total = 0;

  for (int i = 0; i < 200; i++) {

    total += analogRead(PIEZO_PIN);

    delay(5);
  }

  piezoBaseline = total / 200;

  Serial0.println("ALL SENSORS READY");
}

// ---------------- MAIN LOOP ----------------

void loop() {

  // Read FSR
  int fsrValue = analogRead(FSR_PIN);

  // Read Piezo
  int piezoValue = analogRead(PIEZO_PIN);

  int impact = abs(
    piezoValue - piezoBaseline
  );

  // Read MPU6050
  sensors_event_t accel;
  sensors_event_t gyro;
  sensors_event_t temp;

  mpu.getEvent(
    &accel,
    &gyro,
    &temp
  );

  // Acceleration magnitude
  float magnitude = sqrt(
    accel.acceleration.x * accel.acceleration.x +
    accel.acceleration.y * accel.acceleration.y +
    accel.acceleration.z * accel.acceleration.z
  );

  // Dynamic acceleration magnitude
  float dynamicAccel = abs(
    magnitude - 9.81
  );

  // MPU6050 step detection
  if (
    dynamicAccel > STEP_THRESHOLD &&
    millis() - lastStepTime > STEP_INTERVAL
  ) {

    stepCount++;

    lastStepTime = millis();

    Serial0.println("STEP DETECTED");
  }

  // Update piezo baseline when quiet
  if (impact < 40) {

    piezoBaseline =
      (piezoBaseline * 99 + piezoValue) / 100;
  }

  // Battery voltage
  int batteryRaw = analogRead(BATTERY_PIN);

  float adcVoltage =
    (batteryRaw / 4095.0) * 3.3;

  float batteryVoltage =
    adcVoltage * (R1 + R2) / R2;

  float batteryPercentage =
    (batteryVoltage - BATTERY_EMPTY) /
    (BATTERY_FULL - BATTERY_EMPTY) * 100.0;

  batteryPercentage = constrain(
    batteryPercentage, 0, 100
  );

  // ---------------- SERIAL OUTPUT ----------------

  Serial0.print("PIEZO:");
  Serial0.print(piezoValue);

  Serial0.print(",FSR:");
  Serial0.print(fsrValue);

  Serial0.print(",ACCEL:");
  Serial0.print(magnitude, 2);

  Serial0.print(",DYNAMIC:");
  Serial0.print(dynamicAccel, 2);

  Serial0.print(",GYRO_X:");
  Serial0.print(gyro.gyro.x, 2);

  Serial0.print(",GYRO_Y:");
  Serial0.print(gyro.gyro.y, 2);

  Serial0.print(",GYRO_Z:");
  Serial0.print(gyro.gyro.z, 2);

  Serial0.print(",BATTERY:");
  Serial0.print(batteryVoltage, 2);

  Serial0.print(",BATTERY_PERCENT:");
  Serial0.print(batteryPercentage, 1);

  Serial0.print(",STEPS:");
  Serial0.println(stepCount);

  delay(20);
}
